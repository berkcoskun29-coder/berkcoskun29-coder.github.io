# Cloudflare Pages security headers (npm run build copies this file into dist/).
# The main Content-Security-Policy is a <meta> tag in the built index.html (scripts/csp-lib.mjs), because the
# GitHub Pages mirror cannot send headers. Only header-only protections are here: framing is forbidden
# (frame-ancestors is ignored in a meta tag; X-Frame-Options for old browsers).
# Microphone, camera and screen sharing are allowed for this site only.
/*
  Content-Security-Policy: frame-ancestors 'none'
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: microphone=(self), camera=(self), display-capture=(self), geolocation=()

# PWA (v0.24.0): service worker her açılışta denetlensin (yeni sürüm hemen gelsin), önbellekte bayat kalmasın
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

# DeepFilterNet3 dosyaları (v0.29.2): adları sürümlü (v3c: derleme değişince klasör adı da değişir), bir hafta önbellekte kalabilir.
# Model düz bayt olarak gitmeli: tarayıcı gzip'i kendisi açarsa DFN kurulamaz (istemci 1f 8b imzasını denetler).
/dfn/*
  Cache-Control: public, max-age=604800
/dfn/v3c/pkg/df_bg.wasm
  Content-Type: application/wasm
/dfn/v3c/models/DeepFilterNet3_onnx.tar.gz
  Content-Type: application/octet-stream

# Uygulama bildirimi doğru içerik türüyle
/manifest.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: no-cache
